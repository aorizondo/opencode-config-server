# OpenCode Enterprise Config Server - Variables de Entorno
# Copiar a .env y editar con valores reales

# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================================================
# URL base pública del servidor (debe ser HTTPS en producción)
SERVER_BASE_URL=https://opencode-config.tu-empresa.corp

# =============================================================================
# OAUTH2 / AUTENTICACIÓN
# =============================================================================
# URL del endpoint de token de tu proveedor OAuth2 (Keycloak, Auth0, Azure AD, etc.)
OAUTH2_TOKEN_URL=https://auth.tu-empresa.corp/oauth2/token

# Audience (claim 'aud') esperado en el token JWT
OAUTH2_AUDIENCE=opencode-enterprise

# Issuer (claim 'iss') esperado en el token JWT
OAUTH2_ISSUER=https://auth.tu-empresa.corp

# URL del JWKS (JSON Web Key Set) para validar firmas JWT
# Ejemplos:
# Keycloak: https://auth.tu-empresa.corp/realms/tu-realm/protocol/openid-connect/certs
# Auth0:    https://tu-tenant.auth0.com/.well-known/jwks.json
# Azure AD: https://login.microsoftonline.com/tu-tenant-id/discovery/v2.0/keys
JWKS_URL=https://auth.tu-empresa.corp/.well-known/jwks.json

# =============================================================================
# SECRETS PARA INYECCIÓN EN CLIENTES (bootstrap.sh → ~/.opencode.env)
# =============================================================================
# API Key de Anthropic (Claude) - Se inyecta como ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Token de Jira para integración - Se inyecta como OPENCODE_JIRA_TOKEN
OPENCODE_JIRA_TOKEN=xxxxxxxxxxxxxxxxxxxxxx

# Opcional: GitLab PAT para integración
# GITLAB_PAT=glpat-xxxxxxxxxxxxxxxxxxxx

# Opcional: Slack webhook para notificaciones
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Opcional: PagerDuty integration key
# PAGERDUTY_KEY=xxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# CONFIGURACIÓN ADICIONAL (opcional)
# =============================================================================
# Puerto del servidor (por defecto 8000)
# PORT=8000

# Log level (debug, info, warning, error)
# LOG_LEVEL=info

# Entorno (development, staging, production)
# ENVIRONMENT=production
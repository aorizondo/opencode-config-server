# OpenCode Enterprise Config Server -- copy to .env and edit.
# Nothing here is injected into employee machines: this configures the server.

# --- Required in production --------------------------------------------------
# Public origin employees reach. Must be https: session tokens travel in headers
# and inside skill URLs.
OCS_BASE_URL=https://opencode-config.your-company.example

# Signs session tokens. Generate with:
#   python -m opencode_config_server.secret
# Rotating it invalidates every issued token, forcing a fresh login.
OCS_SESSION_SECRET=

# development | production. Production refuses to start without a secret and
# without https.
OCS_ENV=production

# --- Paths -------------------------------------------------------------------
# Holds opencode.jsonc, users.json, skills/ and bootstrap/install.sh.
OCS_CONFIG_DIR=/app/config
# Defaults to $OCS_CONFIG_DIR/users.json.
# OCS_USERS_FILE=/run/secrets/users.json

# --- Tokens ------------------------------------------------------------------
# The harness cannot refresh a command-issued credential, so these are long
# lived. Revoke per user by bumping their "version" in users.json.
OCS_TOKEN_TTL_DAYS=90
# Must match the {env:NAME} placeholders in the corporate document.
OCS_SESSION_ENV=OPENCODE_CORP_SESSION

# --- Hardening ---------------------------------------------------------------
OCS_RATE_LIMIT_ATTEMPTS=10
OCS_RATE_LIMIT_WINDOW=300
# Only enable behind a proxy you control: otherwise clients forge their own
# rate-limit bucket through X-Forwarded-For.
OCS_TRUST_PROXY=false

# --- Feature switches --------------------------------------------------------
OCS_SKILLS_ENABLED=true
OCS_BOOTSTRAP_ENABLED=true

# --- Ops ---------------------------------------------------------------------
OCS_LOG_LEVEL=INFO
OCS_HOST=0.0.0.0
OCS_PORT=8000
